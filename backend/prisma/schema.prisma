generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  foodItems   FoodItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FoodItem {
  id           String        @id @default(uuid())
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  price        Float
  description  String?
  isVeg        Boolean       @default(true)
  imageUrl     String?
  isAvailable  Boolean       @default(true)
  totalSold    Int           @default(0)
  invoiceItems InvoiceItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  phone       String    @unique
  email       String?
  address     String?
  notes       String?
  totalVisits Int       @default(0)
  totalSpent  Float     @default(0.0)
  bookings    Booking[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RestaurantTable {
  id          String    @id @default(uuid())
  tableNumber String    @unique
  capacity    Int
  status      String    @default("AVAILABLE") // AVAILABLE, RESERVED, OCCUPIED, CLEANING
  bookings    Booking[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id            String          @id @default(uuid())
  bookingNumber String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  date          String
  time          String
  guests        Int
  notes         String?
  status        String          @default("PENDING") // PENDING, RESERVED, SEATED, COMPLETED, CANCELLED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Invoice {
  id             String          @id @default(uuid())
  invoiceNumber  String          @unique
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  subtotal       Float
  discount       Float           @default(0.0)
  tax            Float           @default(0.0)
  total          Float
  paymentMethod  String          @default("CASH") // CASH, UPI, CARD
  paymentStatus  String          @default("PAID") // PENDING, PAID, CANCELLED
  amountReceived Float           @default(0.0)
  changeGiven    Float           @default(0.0)
  items          InvoiceItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
}

